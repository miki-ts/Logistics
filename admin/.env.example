# Copy this file to .env locally; never commit the real .env file.
ADMIN_USERNAME=admin
# Generate with: node generate-password-hash.js "a-long-unique-password"
ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_value
# Generate a random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_PORT=8787
NODE_ENV=production

# ── Email notifications (nodemailer / SMTP) ────────────────────────────────
# Gmail: use an App Password from https://myaccount.google.com/apppasswords
# Outlook: smtp-mail.outlook.com  port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zinashlemma4@gmail.com
SMTP_PASS=skyl cvdt tzvy pbse
# Optional: override the From address shown to recipients
SMTP_FROM=YM Logistics <zinashlemma4@gmail.com>

